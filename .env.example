# All generated artifacts and private voice data live here.
YAPIT_WORKSPACE=workspace
YAPIT_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
YAPIT_DEVICE=auto
# Optional. Never used for audio or voice samples.
OPENAI_API_KEY=
YAPIT_SCRIPT_MODEL=gpt-4.1-mini
# Required only for optional --auto-script: explicit permission to send brief/media frames.
YAPIT_ALLOW_CLOUD=false
