# Job metadata, voice profiles, checkpoints and video guides.
YAPIT_WORKSPACE=workspace
# Recordings: audio; scripts/captions: transcripts; synthesized audio: generated_audio.
YAPIT_DATA_DIR=data
YAPIT_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
YAPIT_DEVICE=auto
# Mode launcher overrides device settings per child process, without editing .env.
# Optional Rescript overrides without the launcher (default cpu/int8).
YAPIT_ASR_DEVICE=cpu
YAPIT_ASR_COMPUTE_TYPE=int8
# Optional. Never used for audio or voice samples.
OPENAI_API_KEY=
YAPIT_SCRIPT_MODEL=gpt-4.1-mini
# Required only for optional --auto-script: explicit permission to send brief/media frames.
YAPIT_ALLOW_CLOUD=false
